# Dependency directories — prevent host (macOS) node_modules from
# overwriting the Linux-native ones installed inside the Docker build.
# Vite uses @rollup native binaries; mixing macOS/Linux breaks the build.
**/node_modules

# Previous build output (let Docker build from source every time)
server/public/controller
server/public/tv
server/public/manage
web/controller/dist
web/tv/dist

# Database files
*.db
*.db-shm
*.db-wal

# Dev / tooling
.git
.omc
.claude
stitch-prompts.md
issues.md
docker-compose.dev.yml
