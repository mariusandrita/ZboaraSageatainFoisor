spawn scp -o StrictHostKeyChecking=no server/src/realtime/room.js kenny@zboarasageata.local:/home/kenny/ZboaraSageata/server/src/realtime/room.js
expect { "assword:" { send "kali\r"; exp_continue } eof }

spawn scp -o StrictHostKeyChecking=no web/v1/src/screens/Match.svelte kenny@zboarasageata.local:/home/kenny/ZboaraSageata/web/v1/src/screens/Match.svelte
expect { "assword:" { send "kali\r"; exp_continue } eof }

spawn ssh -o StrictHostKeyChecking=no kenny@zboarasageata.local "cd /home/kenny/ZboaraSageata && npm run build -w web/v1 && sudo systemctl restart dartsleague"
expect { "assword:" { send "kali\r"; exp_continue } eof }
