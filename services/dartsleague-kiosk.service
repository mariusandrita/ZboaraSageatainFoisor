[Unit]
Description=DartsLeague Kiosk (Chromium on /tv)
After=graphical.target dartsleague.service
Wants=dartsleague.service

[Service]
Type=simple
User=kenny
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/kenny/.Xauthority
ExecStart=/home/kenny/ZboaraSageata/ops/kiosk.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
