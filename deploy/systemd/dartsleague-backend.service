[Unit]
Description=DartsLeague Backend (Fastify + Socket.IO)
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/dartsleague/server
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=80
Environment=DB_PATH=/var/lib/dartsleague/dartsleague.db
Environment=LOG_LEVEL=info

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/dartsleague

[Install]
WantedBy=multi-user.target
